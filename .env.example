# LLM Gateway Chat Configuration
CHAT_PORT=3500
LLM_GATEWAY_URL=http://192.168.0.100:3400
TTS_ENDPOINT=http://localhost:2233
# Workshop MCP server (tools dispatcher); /sse/compact is derived from /mcp/compact
MCP_URL=http://192.168.0.100:3100/mcp/compact
MCP_PUBLIC_ORIGIN=same-origin
# nDB v2 service (System of Record). Must mount CHAT_NDB_USERS_DB and be started
# with --dir <root> so per-user chat_<username> databases can be created.
CHAT_NDB_URL=http://127.0.0.1:8323
CHAT_NDB_USERS_DB=chat_users
CHAT_NDB_USER_PREFIX=chat_
# CHAT_NDB_TOKEN=
# nVDB v2 service (search + vectors); must run with --reranker-model
CHAT_NVDB_URL=http://127.0.0.1:3510
CHAT_NVDB_COLLECTION=chat

